# PROXI_ENV is selected in the shell, not in this file (default: development).
PROXI_LOG_LEVEL=INFO
# Backend only. Use a PostgreSQL DSN from the Supabase Connect panel; do not commit credentials.
# PROXI_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full
# Set PROXI_TEST_DATABASE_URL in the shell for tests; testing does not load this file.
# Optional, local-only agent administration. Both settings are required.
# PROXI_DEV_IDENTITY_OWNER_ID=
# PROXI_DEV_IDENTITY_TOKEN=
